{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group non-major Go module updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OCI package tags in documentation",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "uds zarf package deploy oci://(?<depName>ghcr\\.io/[^:]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update uds-common smoke-test task imports",
      "managerFilePatterns": ["/^tasks\\.yaml$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>defenseunicorns/uds-common)/(?<currentValue>v[^/]+)/tasks/(?:actions|create|deploy|setup)\\.yaml"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
